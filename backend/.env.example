# Nivesha Ventures - Platform Environment Configuration
PLATFORM_NAME="Nivesha Ventures"
ENVIRONMENT=production

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
SUPABASE_SECRET_KEY=your_secret_service_role_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Database URL
# Format: postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require
DATABASE_URL=

# Nivesha Diligence Assistant Chatbot API Configuration
# Provide your LLM provider credentials (e.g. OpenAI, Google Gemini, Anthropic, or custom endpoint)
NIVESHA_DILIGENCE_ASSISTANT_API_KEY=your_diligence_assistant_api_key_here
NIVESHA_DILIGENCE_ASSISTANT_API_URL=https://api.openai.com/v1
NIVESHA_DILIGENCE_ASSISTANT_MODEL=gpt-4o

